# benchmark data generated by step1..step5 (bases set in config.sh)
/transmark-full.*
/transmark-full-fs.*
/transmark-full-over.*
/transmark-full-over-fs.*
/transmark-lite.*
/transmark-lite-fs.*
/transmark-lite-over.*
/transmark-lite-over-fs.*
/transmark-*-results*/

# step2-frameshift scratch
/tmp-frameshift/

# build artifacts (make)
/transmark-create
/transmark-rocplot
*.o

# run logs (run-steps.sh / run-full-over.sh / step scripts)
/*.log

# step-last figure + coverage outputs
/coverage-*.txt
/coverage-*.tex
/evalue-scatter-*.png
/modern_rocplot*.png

# python
__pycache__/
*.pyc

# unpacked from tracked seed-files/*.tfile.zip (README: seed file step)
seed-files/train-test.*.tfile

# RStudio leftovers / local junk
/.Rhistory
/.RData
/.Rproj.user/
/.pos

# legacy outputs
/test-001-double/
/test-001-float/

# local archive of retired artifacts
dumpsite/
