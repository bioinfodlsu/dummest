#! /usr/bin/perl 

# Run a transmark benchmark with bathsearch (non-frameshift HMM control).
#
# Usage:      x-bathsearch-no-fs <execdir> <scriptdir> <outdir> <outname> <queryfile> <posfile> <fafile> <cpus> <e-max> [extra-flags]
# Example:  /home/user/BATH-paper/transmark/x-bathsearch-no-fs /home/user/BATH/src /home/user/BATH-paper/transmark  /home/user/transmark-results  transmark-00fs /home/user/transmark-files/transmark-00fs.bhmm /home/user/transmark-files/transmark-00fs.pos /home/user/transmark-files/transmark-00fs.fa 16 100 --max
#
use Time::HiRes;

$usage = "Usages: $0 \n\t<execdir>\n\t<scriptdir>\n\t<outdir>\n\t<outname>\n\t<queryfile>\n\t<posfile>\n\t<targetfile>\n\t<cpus>\n\t<e-max>\n\t[extra-flags]\n";

if(scalar(@ARGV) < 9) { printf("$usage\n"); exit(1); }

($execdir, $scriptdir, $outdir, $outname, $queryfile, $posfile, $targetfile, $cpus, $emax, @extra_flags_list) = @ARGV;
$extra_flags = join(" ", @extra_flags_list);
$outfile        = $outname . ".out";
$tmpoutfile     = $outfile . ".tmp";
$sorttmpoutfile = $outfile . ".tmp.sort";

$idscript      = "$scriptdir/transmark-idpositives.pl";
$bathsearch    = "$execdir/bathsearch";

if (! -d $execdir)      { die "didn't find executable directory $execdir"; }
if (! -d $scriptdir)    { die "didn't find script directory $scriptdir"; }
if (! -e $outdir)       { die "$outdir doesn't exist"; }
if (! -e $posfile)      { die "$posfile doesn't exist"; }
if (! -e $idscript)     { die "positive identification script $idscript doesn't exist"; }

open(TMPOUTFILE,">$outdir/$tmpoutfile") || die "failed to open $outdir/$tmpoutfile";

$runtime = -1 * Time::HiRes::time();

#run bathsearch (non-frameshift HMM; $extra_flags carries e.g. --max)
$command = "$bathsearch --cpu $cpus -E $emax $extra_flags -o $outdir/$outname.search --tblout $outdir/$outname.tmp $queryfile $targetfile";
$status = system("$command");
if ($status != 0) { die "FAILED: $command"; }

$runtime += Time::HiRes::time();

open(OUTPUT, "$outdir/$outname.tmp") || die "FAILED: to open $outdir/$outname.tmp tabular output file";
my $query;

while (<OUTPUT>)
{
    if (/^\#/) { next; }
    @fields   = split(' ', $_);
    $target      = $fields[1];
    $query       = (split('\.', $fields[3]))[1];
    $target_from = $fields[9];
    $target_to   = $fields[10];
    # BATH v2.0.0-rc6 --tblout layout (no env from/env to):
    #   ... ali_from ali_to E-value score bias PID description
    # The non-frameshift tblout omits shifts/stops, so they are zero here.
    $pval        = $fields[11];
    $bitscore    = $fields[12];
    $frameshifts = 0;
    $stops       = 0;
    $pipeline    = 'nofs';
    printf TMPOUTFILE "%10g %10.1f %10d %10d %20s %35s %5d %5d %4s\n", $pval, $bitscore, $target_from, $target_to, $target, $query, $frameshifts, $stops, $pipeline;
}
open(TIME, ">" . "$outdir/$outname.time");
printf TIME ("$outname %.2f seconds\n", $runtime);
close(TIME);

close TMPOUTFILE;
close OUTPUT;
$command = "sort -g $outdir/$tmpoutfile > $outdir/$sorttmpoutfile";
$status = system("$command");
if ($status != 0) { die "FAILED: $command"; }

$command = "perl $idscript $posfile $outdir/$sorttmpoutfile > $outdir/$outfile";
$status = system("$command");
if ($status != 0) { die "FAILED: $command"; }
