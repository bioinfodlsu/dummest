#!/usr/bin/env python3
import sys
import os
import subprocess
import tempfile
import argparse
import threading
import traceback


def _cache_dir():
    # Shared with dummest: $DUMMEST_CACHE_DIR, then
    # $XDG_CACHE_HOME/.dummest-cache, $HOME/.dummest-cache, ./.dummest-cache,
    # $TMPDIR/.dummest-cache, /tmp/.dummest-cache, then /tmp.
    candidates = []
    override = os.environ.get("DUMMEST_CACHE_DIR")
    if override:
        candidates.append(override)
    xdg = os.environ.get("XDG_CACHE_HOME")
    if xdg:
        candidates.append(os.path.join(xdg, ".dummest-cache"))
    home = os.environ.get("HOME")
    if home:
        candidates.append(os.path.join(home, ".dummest-cache"))
    candidates.append(os.path.join(os.getcwd(), ".dummest-cache"))
    tmp = os.environ.get("TMPDIR") or tempfile.gettempdir()
    if tmp:
        candidates.append(os.path.join(tmp, ".dummest-cache"))
    candidates.append("/tmp/.dummest-cache")

    for d in candidates:
        try:
            os.makedirs(d, exist_ok=True)
            if os.access(d, os.W_OK):
                return d
        except OSError:
            continue
    return "/tmp"


def _tmp_dir():
    # Temporary workspace: defaults to the cache dir, overridable via DUMMEST_TMP.
    # A DUMMEST_TMP override is assumed writable (the caller fails loudly if not).
    override = os.environ.get("DUMMEST_TMP")
    if override:
        os.makedirs(override, exist_ok=True)
        return override
    return _cache_dir()


def _gpu_available():
    # True iff an NVIDIA GPU is actually usable: nvidia-smi must both exist
    # and succeed (in a container without --nv it may exist yet fail).
    try:
        r = subprocess.run(["nvidia-smi", "-L"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return False
    return r.returncode == 0


def _resolve_gpu(mode):
    if mode == "on":
        return True
    if mode == "off":
        return False
    return _gpu_available()


def _engine_failed(returncode):
    print(f"Error: dummest encountered an issue (Exit status: {returncode})")
    sys.exit(1)


# awk stage: unpack the fake chrom "chrom|profile|strand" produced upstream
# into a real-chrom BED record (chrom, start, end, query, ".", strand).
_AWK_UNPACK = r'''BEGIN { FS = "\t"; OFS = "\t" }
{
    n = split($1, a, "|")
    if (n < 3) {
        print "# WARNING: malformed interval name: " $1 > "/dev/stderr"
        exit 1
    }
    chrom = a[1]
    for (i = 2; i <= n - 2; i++)
        chrom = chrom "|" a[i]
    print chrom, $2, $3, a[n-1], ".", a[n]
}'''


def _stream_bed_from_convertalis(src, dst, dna_lens, hmm_lens, errors):
    # Stream BLAST-tab rows from `mmseqs convertalis --output-stdout` and
    # write BED records (fake chrom chrom|profile|strand), mirroring the
    # historic in-memory parser.
    malformed = 0
    try:
        for lineno, line in enumerate(src, 1):
            if line.startswith(b"#"):
                continue

            fields = line.split()
            if len(fields) < 12:
                continue

            query_acc = fields[0]
            target_full = fields[1]
            try:
                int(fields[6])
                int(fields[7])
                t_start = int(fields[8])
                t_end = int(fields[9])
            except ValueError:
                malformed += 1
                if malformed <= 5:
                    print(f"# WARNING: skipping convertalis line {lineno} "
                          f"with non-integer coords: "
                          f"{line.decode('utf-8', 'replace').strip()!r}",
                          file=sys.stderr)
                continue
            p_pos = max(1, (t_start + t_end) // 2)
            bitscore = fields[11]

            target_parts = target_full.rsplit(b'_', 1)
            target_base = target_parts[0] if len(target_parts) == 2 else b""
            frame_str = target_parts[-1]
            try:
                frame_val = int(frame_str.split(b'=')[1])
            except (IndexError, ValueError):
                # Run-A hardening: log-and-skip a malformed convertalis
                # target instead of crashing the hour-long run.
                malformed += 1
                if malformed <= 5:
                    print(f"# WARNING: skipping convertalis line {lineno} "
                          f"with malformed target (expected *_frame=±N): "
                          f"{target_full.decode('utf-8', 'replace')!r} :: "
                          f"{line.decode('utf-8', 'replace').strip()!r}",
                          file=sys.stderr)
                continue
            strand, frame = (b'+', frame_val) if frame_val > 0 else (b'-', -frame_val)

            L = dna_lens.get(target_base.decode("utf-8", "replace"), 0)
            if L == 0:
                continue
            pad = 3 * hmm_lens.get(query_acc.decode("utf-8", "replace"), 0)

            base_pos = (frame - 1) + 3 * (p_pos - 1)

            if strand == b'+':
                start = max(0, base_pos - pad)
                end = min(L, base_pos + 1 + pad)
                fake_chrom = target_base + b"|" + query_acc + b"|+"
            else:
                start = max(0, L - base_pos - 1 - pad)
                end = min(L, L - base_pos + pad)
                fake_chrom = target_base + b"|" + query_acc + b"|-"

            dst.write(b"%s\t%d\t%d\t%s\t%s\t%s\n"
                      % (fake_chrom, start, end, query_acc, bitscore, strand))

        if malformed:
            print(f"# WARNING: skipped {malformed} malformed convertalis "
                  f"row(s) (see first 5 above)", file=sys.stderr)
    except BrokenPipeError:
        pass
    except Exception:
        errors.append(traceback.format_exc())
    finally:
        try:
            dst.close()
        except Exception:
            pass
        try:
            src.close()
        except Exception:
            pass


def _rewrite_fasta(src, engine_stdin, out_handle, dna_lens, errors):
    # bedtools getfasta -name+ headers: ">QUERY::chrom:start-end(strand)".
    # Rewrite them to the pipeline FASTA header the engine expects:
    #   >chrom/start-end length=L profile=QUERY strand_label
    try:
        for line in src:
            if line.startswith(b">"):
                header_data = line[1:].strip()
                if b"::" in header_data:
                    query, coord_part = header_data.split(b"::")
                else:
                    query, coord_part = b"UNKNOWN", header_data
                chrom_b, rest = coord_part.split(b":")
                pos, strand_part = rest.split(b"(")
                start_str, end_str = pos.split(b"-")
                strand_sign = strand_part[:1]

                start, end = int(start_str), int(end_str)
                chrom = chrom_b.decode("utf-8", "replace")
                strand_label = "plus_strand" if strand_sign == b"+" else "minus_strand_revcomp"

                new_line = (b">" + chrom_b + b"/" + str(start + 1).encode()
                            + b"-" + str(end).encode()
                            + b" length=" + str(dna_lens.get(chrom, 0)).encode()
                            + b" profile=" + query + b" "
                            + strand_label.encode() + b"\n")
            else:
                new_line = line

            if out_handle is not None:
                out_handle.write(new_line)
            if engine_stdin is not None:
                engine_stdin.write(new_line)
    except BrokenPipeError:
        pass
    except Exception:
        errors.append(traceback.format_exc())
    finally:
        for h in (engine_stdin, out_handle):
            if h is not None:
                try:
                    h.close()
                except Exception:
                    pass
        try:
            src.close()
        except Exception:
            pass


def _write_max_fasta(engine_stdin, out_handle, dna_seqs, hmm_lens, trans):
    # Stream the --max cross product (contig x profile x 2 strands) without
    # materializing it on disk; optionally tee to --output-fa.
    buf = []
    buflen = 0

    def flush():
        nonlocal buflen
        if not buf:
            return
        data = b"".join(buf)
        del buf[:]
        buflen = 0
        if out_handle is not None:
            out_handle.write(data)
        if engine_stdin is not None:
            engine_stdin.write(data)

    try:
        for chrom, seq in dna_seqs.items():
            L = len(seq)
            rc_seq = seq.translate(trans)[::-1]
            seq_nl = (seq + "\n").encode("utf-8")
            rc_seq_nl = (rc_seq + "\n").encode("utf-8")
            for prof in sorted(hmm_lens):
                head = f">{chrom}/1-{L} length={L} profile={prof} "
                plus = (head + "plus_strand\n").encode("utf-8")
                minus = (head + "minus_strand_revcomp\n").encode("utf-8")
                buf.extend((plus, seq_nl, minus, rc_seq_nl))
                buflen += len(plus) + len(seq_nl) + len(minus) + len(rc_seq_nl)
                if buflen >= 1 << 20:
                    flush()
        flush()
    except BrokenPipeError:
        pass
    finally:
        if engine_stdin is not None:
            try:
                engine_stdin.close()
            except (BrokenPipeError, OSError):
                pass
        if out_handle is not None:
            out_handle.close()


def main():
    parser = argparse.ArgumentParser(
        description="Pipeline: HMM-guided genomic search via MMseqs2 + dummest",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Examples:\n"
               "  dummest profile.hmm msa.msa genome.fa 8\n"
               "  dummest profile.hmm msa.msa genome.fa 8 --target-db-pad /path/to/targetDB_pad --query-db /path/to/queryDB\n"
    )
    parser.add_argument("hmm_file", help="HMM profile file")
    parser.add_argument("msa_file", help="MSA file (.msa for Stockholm, otherwise used as-is for query DB). Ignored when --query-db is provided.")
    parser.add_argument("fa_file", help="Genome FASTA file")
    parser.add_argument("cpus", help="Number of CPUs")
    parser.add_argument("--target-db-pad", dest="target_db_pad", default=None,
                        help="Path to an existing padded target DB (skips createdb)")
    parser.add_argument("--query-db", dest="query_db", default=None,
                        help="Path to an existing query profile DB (skips convertmsa + msa2profile)")
    parser.add_argument("--skip-dummest", dest="skip_dummer", action="store_true",
                        help="Skip running dummest (only generate debug.fa)")
    parser.add_argument("--output-fa", dest="output_fa", default=None,
                        help="Save debug FASTA to this path (persistent copy)")
    parser.add_argument("--max", action="store_true",
                        help="Max sensitivity: disable heuristic windowing (pad=full contig)")
    parser.add_argument("--dummest-bin", dest="dummer_bin", metavar="DUMMEST_BIN", default=None,
                        help="Path to dummest engine binary (overrides default dummestl_core next to this script)")
    parser.add_argument("--prefilter-mode", type=int, default=1, choices=[1],
                        help="MMseqs2 prefilter mode (currently only 1 = ungapped "
                             "prefilter, applies --ungapped-pvalue).")
    parser.add_argument("--gpu", choices=["auto", "on", "off"], default="auto",
                        help="MMseqs2 GPU use: auto (default; GPU when nvidia-smi "
                             "reports one, else CPU), on (fail if no GPU), off (CPU only).")
    parser.add_argument("--gapped-pvalue", dest="gapped_pvalue", type=float, default=0.005,
                         help="P-value threshold for the gapped (Smith-Waterman) alignment, "
                              "stage 2 of the MMseqs2 search (default: 0.005). Stage 1 is "
                              "the ungapped prefilter, gated by --ungapped-pvalue. "
                              "Forwarded to 'mmseqs search' as -e <nseq*6*pvalue>, where nseq "
                              "is the number of genome entries (six reading frames each). "
                              "Ignored in --max mode, which skips MMseqs2.")
    parser.add_argument("--ungapped-pvalue", dest="ungapped_pvalue", type=float, default=0.02,
                        help="Max per-pair ungapped p-value for the prefilter stage (default: 0.02). "
                             "Passed as --ungapped-pvalue to 'mmseqs search'. "
                             "Use 1.0 to disable p-value filtering (score floor only).")
    parser.add_argument("--prefilter-max-seqs", dest="prefilter_max_seqs", type=int, default=2147483647,
                         help="MMseqs2 prefilter max hits per protein family "
                              "(per query profile) kept from the prefilter (default: 2147483647, i.e. keep all). "
                              "Passed as --max-seqs to 'mmseqs ungappedprefilter'. "
                              "Ignored in --max mode, which skips MMseqs2.")
    parser.add_argument("--ungapped-calib", dest="ungapped_calib", default=None,
                         help="Path to sidecar cache for per-profile ungapped calibration "
                              "(default: .dummest-cache/ungappedcalib.tsv, shared across runs: "
                              "rows are keyed by profile-content hash, so sharing is safe). "
                              "Passed as --ungapped-calib to 'mmseqs search'. "
                              "Ignored in --max mode, which skips MMseqs2.")
    parser.add_argument("--ungapped-recalibrate", dest="ungapped_recalibrate", action="store_true",
                         help="Ignore cache entries and recalibrate every profile "
                              "(passed as --ungapped-recalibrate 1 to 'mmseqs search'). "
                              "Ignored in --max mode, which skips MMseqs2.")
    parser.add_argument("--mmseqs-bin", dest="mmseqs_bin", default=None,
                         help="Path to mmseqs binary (overrides default mmseqs from PATH)")
    parser.add_argument("--insert1", type=float, default=None,
                        help="DUMMEST 1-base insertion rate per base (default: dummest default 0.0171)")
    parser.add_argument("--insert2", type=float, default=None,
                        help="DUMMEST 2-base insertion rate per base (default: dummest default 0.0018)")
    parser.add_argument("--delete1", type=float, default=None,
                        help="DUMMEST 1-base deletion rate per base (default: dummest default 0.0328)")
    parser.add_argument("--delete2", type=float, default=None,
                        help="DUMMEST 2-base deletion rate per base (default: dummest default 0.0083)")
    parser.add_argument("--stop-codon-prob", dest="stop_codon_prob", type=float, default=None,
                        help="DUMMEST stop codon probability (default: dummest default 0.0005)")
    parser.add_argument("--bg-stop-codon-prob", dest="bg_stop_codon_prob", type=float, default=None,
                        help="DUMMEST background stop codon probability (default: dummest default 0.046875)")
    parser.add_argument("--tantan-threshold", dest="tantan_threshold", type=float, default=None,
                        help="DUMMEST tantan masking threshold (default: dummest default 0.5)")
    parser.add_argument("--evalue", "-e", dest="evalue", type=float, default=10,
                        help="DUMMEST E-value threshold (default: 10). Forwarded as both -e and -W to dummest.")
    parser.add_argument("--batch", dest="batch", type=int, default=800000,
                        help="DUMMEST stream chunk size in sequences (default: 800000). "
                             "Small values force multi-chunk streaming.")
    parser.add_argument("--trials", dest="trials", type=int, default=None,
                        help="DUMMEST calibration random sequences (-t). "
                             "Default: dummest default (1000).")
    parser.add_argument("--length", "-l", dest="length", type=int, default=None,
                        help="DUMMEST calibration random sequence length (-l). "
                             "Default: dummest default (5000).")

    args = parser.parse_args()

    if args.gapped_pvalue is None or not args.gapped_pvalue >= 0:
        parser.error("--gapped-pvalue must be >= 0")
    if args.ungapped_pvalue is None or not 0 <= args.ungapped_pvalue <= 1:
        parser.error("--ungapped-pvalue must be in [0, 1]")
    if args.prefilter_max_seqs is None or args.prefilter_max_seqs < 1:
        parser.error("--prefilter-max-seqs must be >= 1")
    for _name in ("insert1", "insert2", "delete1", "delete2",
                  "stop_codon_prob", "bg_stop_codon_prob"):
        _v = getattr(args, _name)
        if _v is not None and not 0 <= _v < 1:
            parser.error(f"--{_name.replace('_', '-')} must be in [0, 1)")
    if args.tantan_threshold is not None and not 0 <= args.tantan_threshold <= 1:
        parser.error("--tantan-threshold must be in [0, 1]")
    if args.evalue is None or not args.evalue >= 0:
        parser.error("--evalue must be >= 0")
    if args.batch is not None and args.batch < 1:
        parser.error("--batch must be >= 1")
    if args.trials is not None and args.trials < 1:
        parser.error("--trials must be >= 1")
    if args.length is not None and args.length < 1:
        parser.error("--length must be >= 1")

    dummer_extra_args = []
    for _dest, _flag in [
        ("batch", "--batch"),
        ("trials", "-t"),
        ("length", "-l"),
        ("insert1", "--insert1"),
        ("insert2", "--insert2"),
        ("delete1", "--delete1"),
        ("delete2", "--delete2"),
        ("stop_codon_prob", "--stop-codon-prob"),
        ("bg_stop_codon_prob", "--bg-stop-codon-prob"),
        ("tantan_threshold", "--tantan-threshold"),
    ]:
        _v = getattr(args, _dest)
        if _v is not None:
            dummer_extra_args += [_flag, str(_v)]

    hmm_file = args.hmm_file
    msa_file = args.msa_file
    fa_file = args.fa_file
    cpus = args.cpus
    if args.ungapped_calib is None:
        args.ungapped_calib = os.path.join(_cache_dir(), "ungappedcalib.tsv")

    tmp_parent = _tmp_dir()
    print(f"# Temporary directory base: {tmp_parent}")

    script_dir = os.path.dirname(os.path.realpath(__file__))
    dummer_exec = args.dummer_bin or os.path.join(script_dir, "dummestl_core")
    mmseqs_exec = args.mmseqs_bin or "mmseqs"

    # ---------------------------------------------------------
    # 1. Parse sequences and HMMs
    # ---------------------------------------------------------
    hmm_lens = {}
    with open(hmm_file, 'r') as f:
        curr_acc, curr_name = None, None
        for line in f:
            if line.startswith("NAME"):
                curr_name = line.split()[1].strip()
            elif line.startswith("ACC"):
                curr_acc = line.split()[1].strip()
            elif line.startswith("LENG"):
                length = int(line.split()[1].strip())
                if curr_acc: hmm_lens[curr_acc] = length
                if curr_name: hmm_lens[curr_name] = length
                curr_acc, curr_name = None, None

    # Full sequences are only needed by --max (streamed to the engine);
    # the default path only needs per-contig lengths for window mapping.
    dna_lens = {}
    dna_seqs = {}
    with open(fa_file, 'r') as f:
        curr_id = None
        curr_seq = []
        for line in f:
            line = line.strip()
            if line.startswith(">"):
                if curr_id:
                    dna_lens[curr_id] = len("".join(curr_seq))
                    if args.max:
                        dna_seqs[curr_id] = "".join(curr_seq)
                curr_id = line[1:].split()[0]
                curr_seq = []
            elif curr_id:
                curr_seq.append(line)
        if curr_id:
            dna_lens[curr_id] = len("".join(curr_seq))
            if args.max:
                dna_seqs[curr_id] = "".join(curr_seq)

    # total search space: all genome lengths, doubled for both strands
    tot_seq_len = sum(dna_lens.values()) * 2

    # ---------------------------------------------------------
    # --max mode: skip mmseqs2, stream all profiles x contigs to dummer
    # ---------------------------------------------------------
    if args.max:
        if args.skip_dummer and not args.output_fa:
            print("# --skip-dummest set without --output-fa: nothing to produce")
            return

        engine_cmd = [dummer_exec, hmm_file, '-', '-T', str(cpus), '--max',
                      '-e', str(args.evalue), '-N', str(tot_seq_len)] + dummer_extra_args
        print(f"# Max mode: streaming {len(dna_seqs)} contig(s) x "
              f"{len(hmm_lens)} profile entries x 2 strands to dummest")

        engine_proc = None
        out_handle = open(args.output_fa, "wb") if args.output_fa else None
        if not args.skip_dummer:
            engine_proc = subprocess.Popen(engine_cmd, stdin=subprocess.PIPE,
                                           bufsize=1024 * 1024)
        trans = str.maketrans("ACGTacgt", "TGCAtgca")
        try:
            _write_max_fasta(engine_proc.stdin if engine_proc else None,
                             out_handle, dna_seqs, hmm_lens, trans)
        except Exception:
            if engine_proc is not None:
                engine_proc.terminate()
            raise
        if engine_proc is not None:
            rc = engine_proc.wait()
            if rc != 0:
                _engine_failed(rc)
        if args.output_fa:
            print(f"# Debug FASTA saved to: {args.output_fa}")

        return

    with tempfile.TemporaryDirectory(prefix="mmseqs_tmp_", dir=tmp_parent, delete=True) as tmpdir:
        print(f"# Temporary directory is: {tmpdir}")

        # ---------------------------------------------------------
        # 3. MMseqs Protein-Protein Search
        # ---------------------------------------------------------
        db_dir = os.path.join(tmpdir, "db")
        os.makedirs(db_dir)

        use_gpu = _resolve_gpu(args.gpu)
        gpu_flag = "1" if use_gpu else "0"
        print(f"# MMseqs2 prefilter: {'GPU' if use_gpu else 'CPU-only'} (--gpu {gpu_flag})")

        ali_file = os.path.join(db_dir, "result.ali")

        if args.target_db_pad:
            target_db_pad = args.target_db_pad
            print(f"# Using existing target_db_pad: {target_db_pad}")
        else:
            # Parity with step3-dummer-precompute.sh:
            #   seqkit seq -m 3 <fa> | seqkit translate -f 6 -F
            # Short (<3nt) DNAs are auto-removed by the -m 3 pre-filter so
            # per-run and prebuilt DBs stay identical; empty protein frames
            # from >=3nt DNAs are intentionally retained.
            # Stream the 6-frame translation straight into createdb's stdin.
            print("# 6-frame translate with -m 3 pre-filter (parity with step3-dummer-precompute.sh)")
            target_db_pad = os.path.join(db_dir, "targetDB_pad")
            p1 = subprocess.Popen(["seqkit", "seq", "-m", "3", fa_file],
                                  stdout=subprocess.PIPE)
            p2 = subprocess.Popen(["seqkit", "translate", "-f", "6", "-F",
                                   "--threads", str(cpus)],
                                  stdin=p1.stdout, stdout=subprocess.PIPE)
            p1.stdout.close()
            p3 = subprocess.Popen([mmseqs_exec, "createdb", "stdin", target_db_pad,
                                   "--gpu", gpu_flag, "--threads", cpus],
                                  stdin=p2.stdout, stdout=subprocess.DEVNULL)
            p2.stdout.close()
            ret3 = p3.wait()
            ret2 = p2.wait()
            ret1 = p1.wait()
            if ret1 != 0 or ret2 != 0 or ret3 != 0:
                raise subprocess.CalledProcessError(ret3 or ret2 or ret1,
                                                    "seqkit seq -m 3 | seqkit translate -f 6 -F | mmseqs createdb stdin")

        if args.query_db:
            query_db = args.query_db
            print(f"# Using existing query_db: {query_db}")
        else:
            query_db = os.path.join(db_dir, "queryDB")
            msa_db = os.path.join(db_dir, "msa_db")
            subprocess.run([mmseqs_exec, "convertmsa", msa_file, msa_db, "--identifier-field", "0"], check=True, stdout=subprocess.DEVNULL)
            subprocess.run([mmseqs_exec, "msa2profile", msa_db, query_db, "--threads", cpus], check=True, stdout=subprocess.DEVNULL)

        # Gapped search (Smith-Waterman) on prefilter survivors. The
        # prefilter stage is ungappedprefilter, where --ungapped-pvalue
        # filters hits before SW.
        # Final significance is the SW E-value (-e); dummer re-scores windows.
        mmseqs_cmd = [
            mmseqs_exec, "search", query_db, target_db_pad, ali_file, tmpdir,
            "--gpu", gpu_flag,
            "--threads", cpus,
            "-e", str(len(dna_lens) * 6 * args.gapped_pvalue),
            "--max-seqs", str(args.prefilter_max_seqs),
            "--prefilter-mode", str(args.prefilter_mode),
            "--ungapped-pvalue", str(args.ungapped_pvalue),
            "--ungapped-calib", args.ungapped_calib,
            "--alignment-mode", "2",
        ]
        # Ungapped prefilter runs identically on CPU and GPU (custom fork);
        # --gpu only selects the device passed to mmseqs.
        if args.ungapped_recalibrate:
            mmseqs_cmd.extend(["--ungapped-recalibrate", "1"])
        print(f"# Ungapped calibration cache: {args.ungapped_calib}"
              + (" (recalibrating)" if args.ungapped_recalibrate else ""))

        subprocess.run(mmseqs_cmd, check=True)

        # ---------------------------------------------------------
        # 4-6. Stream convertalis -> BED -> sort/merge -> getfasta ->
        #      rewrite -> dummest. Nothing in between touches the disk.
        # ---------------------------------------------------------
        if args.skip_dummer and not args.output_fa:
            print("# --skip-dummest set without --output-fa: nothing to produce")
            return

        # bedtools writes <fi>.fai next to the input FASTA; if fa_file lives on
        # a read-only mount (e.g. the Apptainer image), that fails. Symlink it
        # into the writable tmpdir so the index is created there instead; reuse
        # an existing .fai when the caller already has one.
        bedtools_fa = os.path.join(tmpdir, os.path.basename(fa_file))
        if os.path.lexists(bedtools_fa):
            os.remove(bedtools_fa)
        os.symlink(os.path.abspath(fa_file), bedtools_fa)
        fai_src = fa_file + ".fai"
        if os.path.exists(fai_src) and not os.path.lexists(bedtools_fa + ".fai"):
            os.symlink(os.path.abspath(fai_src), bedtools_fa + ".fai")

        engine_cmd = [dummer_exec, hmm_file, '-', '-T', str(cpus),
                      '-e', str(args.evalue), '-W', str(args.evalue),
                      '-N', str(tot_seq_len)] + dummer_extra_args

        conv_proc = subprocess.Popen(
            [mmseqs_exec, "convertalis", query_db, target_db_pad, ali_file,
             os.path.join(tmpdir, "convertalis.stdout.ignore"),
             "--output-stdout", "1", "--threads", cpus, "-v", "1"],
            stdout=subprocess.PIPE)
        sort_proc = subprocess.Popen(["bedtools", "sort", "-i", "stdin"],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE)
        merge_proc = subprocess.Popen(["bedtools", "merge", "-i", "stdin"],
                                      stdin=sort_proc.stdout, stdout=subprocess.PIPE)
        sort_proc.stdout.close()
        awk_proc = subprocess.Popen(["awk", _AWK_UNPACK],
                                    stdin=merge_proc.stdout, stdout=subprocess.PIPE)
        merge_proc.stdout.close()
        get_proc = subprocess.Popen(["bedtools", "getfasta", "-fi", bedtools_fa,
                                     "-bed", "stdin", "-s", "-name+"],
                                    stdin=awk_proc.stdout, stdout=subprocess.PIPE)
        awk_proc.stdout.close()

        engine_proc = None
        out_handle = open(args.output_fa, "wb") if args.output_fa else None
        if not args.skip_dummer:
            engine_proc = subprocess.Popen(engine_cmd, stdin=subprocess.PIPE,
                                           bufsize=1024 * 1024)

        procs = [("mmseqs convertalis", conv_proc), ("bedtools sort", sort_proc),
                 ("bedtools merge", merge_proc), ("awk", awk_proc),
                 ("bedtools getfasta", get_proc)]
        if engine_proc is not None:
            procs.append(("dummest", engine_proc))

        errors = []
        t_parse = threading.Thread(
            target=_stream_bed_from_convertalis,
            args=(conv_proc.stdout, sort_proc.stdin, dna_lens, hmm_lens, errors))
        t_rewrite = threading.Thread(
            target=_rewrite_fasta,
            args=(get_proc.stdout,
                  engine_proc.stdin if engine_proc is not None else None,
                  out_handle, dna_lens, errors))
        t_parse.start()
        t_rewrite.start()

        try:
            rc_engine = engine_proc.wait() if engine_proc is not None else 0
            t_parse.join()
            t_rewrite.join()
            if out_handle is not None:
                out_handle.close()
                out_handle = None

            if rc_engine != 0:
                _engine_failed(rc_engine)

            failed = []
            if errors:
                for e in errors:
                    print(e, file=sys.stderr)
                failed.append("pipeline stages crashed")
            for name, proc in procs:
                rc = proc.wait()
                if rc != 0:
                    failed.append(f"{name} (exit {rc})")

            if failed:
                print("Error: pipeline stage failed: " + ", ".join(failed),
                      file=sys.stderr)
                sys.exit(1)

            if args.output_fa:
                print(f"# Debug FASTA saved to: {args.output_fa}")
        finally:
            for _, proc in procs:
                if proc.poll() is None:
                    proc.terminate()
            if out_handle is not None and not out_handle.closed:
                out_handle.close()


if __name__ == "__main__":
    main()
