Bootstrap: docker
From: ubuntu:24.04

%labels
    Author dummest
    Version 1.0
    Description DUMMEST with a custom GPU MMseqs2 fork (GPU ungapped-prefilter p-values)

%help
    DUMMEST Apptainer container.

    Binaries in PATH: dummest (pipeline), dummest_core, dummestl_core,
    dummest-build, mmseqs (custom GPU fork), seqkit, bedtools.
    Legacy symlink: pipeline.py -> dummest.

    GPU runs (NVIDIA only) need the host driver injected with --nv:
      apptainer exec --nv dummest.sif dummest profile.hmm profile.msa genome.fa 8

    Inside the container the pipeline uses the dummest cache directory for
    temporary scratch space. Override it, e.g. to a large disk directory:
      apptainer exec --env DUMMEST_TMP=/host/large_tmp dummest.sif dummest ...

    CPU-only smoke test on the bundled fixtures:
      apptainer exec dummest.sif dummest /opt/dummest/samples/MET-test.hmm \
          /opt/dummest/samples/MET.msa /opt/dummest/samples/MET-target.fa 4 --batch 1

    Full in-container suite (smoke + overflow; slow on first run):
      apptainer test dummest.sif
    Adds CPU-vs-GPU prefilter parity (needs a GPU):
      apptainer test --nv dummest.sif

    Build with ./build_apptainer.sh (requires MMSEQS_SRC=<MMseqs2 fork tree>).

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:$PATH

%files
    .apptainer-stage/dummest_core /usr/local/bin/dummest_core
    .apptainer-stage/dummestl_core /usr/local/bin/dummestl_core
    .apptainer-stage/dummest-build /usr/local/bin/dummest-build
    .apptainer-stage/dummest /usr/local/bin/dummest
    .apptainer-stage/mmseqs /usr/local/bin/mmseqs
    .apptainer-stage/payload /opt/dummest

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    apt-get update
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        bedtools \
        seqkit \
        zlib1g \
        libbz2-1.0 \
        libgomp1 \
        libatomic1
    rm -rf /var/lib/apt/lists/*

    # Python deps for bin/dummest (numpy arrives via pybedtools).
    # --break-system-packages is required on Ubuntu 24.04.
    pip3 install --no-cache-dir --break-system-packages pybedtools

    chmod 755 /usr/local/bin/dummest /usr/local/bin/dummest_core /usr/local/bin/dummestl_core /usr/local/bin/dummest-build /usr/local/bin/mmseqs
    ln -sf dummest /usr/local/bin/pipeline.py

%runscript
    exec dummest "$@"

%test
    set -eux
    export PATH=/usr/local/bin:$PATH
    mmseqs version
    seqkit version
    bedtools --version
    dummest --help | head -5
    dummest_core --help | head -5
    # Smoke: full pipeline (MMseqs2 prefilter + dummest) on bundled test data.
    # GPU is auto-selected when present; plain `apptainer test` uses CPU.
    dummest /opt/dummest/samples/MET-test.hmm /opt/dummest/samples/MET.msa /opt/dummest/samples/MET-target.fa 2 --batch 1
    # Overflow/rescale regression on the image's own binaries.
    DUMMER_BIN=dummest_core DUMMERL_BIN=dummestl_core bash /opt/dummest/tests/test_overflow.sh
    # CPU-vs-GPU prefilter parity; needs `apptainer test --nv`, skips without a GPU.
    bash /opt/dummest/tests/test_gpu.sh
